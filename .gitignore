celerybeat-schedule
celerybeat.pid

# Pytest / Coverage
.coverage
.tox/
nosetests.xml
coverage.xml
*.cover
*.py,cover
*.hypothesis/

# Migrations (optional—comment out if you want to track them)
*/migrations/*
!*/migrations/__init__.py

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Virtualenv
venv/
ENV/
env/
env.bak/
*.egg-info/
.eggs/
.Python

# IDE / Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ==========================================
# NODE / FRONTEND (if using React, Vite, etc.)
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# FLUTTER
# ==========================================
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/pubspec.lock
**/.gradle/
