# ==========================================
# PYTHON / DJANGO
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Django stuff:
*.log
*.pot
*.pyc
db.sqlite3
instance/
media/
staticfiles/
.env
.env.local
.env.development
.env.production
.env.*
